# DEALMESH - Environment Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Default: SQLite for zero-config local run, PostgreSQL supported)
DATABASE_URL="file:./dev.db"

# OKX API Configuration (Production / Sandbox)
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_PROJECT_ID=dealmesh-okx-agent-hub
OKX_A2A_NETWORK=testnet
OKX_XLAYER_RPC=https://xlayertestrpc.okx.com
OKX_XLAYER_CHAIN_ID=195
OKX_DEMO_MODE=true

# AI Provider Configuration (Optional for live LLM, default built-in AI provider)
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gpt-4o-mini
